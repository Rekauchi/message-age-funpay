{
  "manifest_version": 3,
  "name": "Message Age",
  "version": "1.3.0",
  "description": "Show a live elapsed timer on FunPay message timestamps.",
  "minimum_chrome_version": "96",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Message Age",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://funpay.com/*",
    "https://www.funpay.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*",
        "https://www.funpay.com/*"
      ],
      "js": [
        "timestamp.js",
        "selection.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
