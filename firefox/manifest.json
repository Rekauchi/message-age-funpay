{
  "manifest_version": 3,
  "name": "Message Age",
  "version": "1.3.0",
  "description": "Show a live elapsed timer on FunPay message timestamps.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Message Age",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://funpay.com/*",
    "https://www.funpay.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*",
        "https://www.funpay.com/*"
      ],
      "js": [
        "timestamp.js",
        "selection.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "message-age-funpay@rekauchi",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
